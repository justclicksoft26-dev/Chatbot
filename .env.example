# Copy to .env and fill in. Never commit the real .env file.

# ── Business profile ─────────────────────────────────────────────────
# justclick = JustClick ERP (default) | ecosafe = ECO SAFE CRM
APP_PROFILE=justclick

# ── Oracle (the ERP database) ────────────────────────────────────────
DB_HOST=
DB_PORT=1521
DB_SID=
DB_USER=
DB_PASS=
# Optional least-privilege users: SELECT-only reader and a DML user for action tables
DB_READ_USER=
DB_READ_PASS=
DB_DML_USER=
DB_DML_PASS=

# ── LLM ──────────────────────────────────────────────────────────────
LLM_PROVIDER=groq            # groq | gemini
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash   # Google retires models; if a call answers 404 "no longer available", pick a current one
GEMINI_THINKING_LEVEL=low       # low keeps answers fast; off/default = the model's own setting
LLM_TIMEOUT_SECONDS=60          # no LLM call waits longer than this
LLM_MAX_RETRIES=2               # retries of a rate-limited / overloaded call (503, 504, 429) before giving up
LLM_RETRY_MAX_WAIT_SECONDS=20   # never wait longer than this between retries
INTENT_LLM=                     # 1 = classify questions with an extra LLM call (only useful with ANSWER_MODE=templates)

# ── Security ─────────────────────────────────────────────────────────
API_KEY=                     # when set, every request needs the X-API-Key header
AUTH_MODE=api_key            # api_key (one shared key) | keys (one personal key + role per user: python -m security.users) | jwt
JWT_SECRET=                  # shared with APEX: in AUTH_MODE=keys it verifies the signed tokens APEX sends (docs/APEX.md); required when AUTH_MODE=jwt
FRAME_ANCESTORS=             # origins that may show the chat in an iframe, e.g. the APEX application (https://apex.example.com); empty = nobody
SSO_MAX_TOKEN_SECONDS=       # longest lifetime a signed token may claim (default 3600)
ADMIN_API_KEY=               # opens the admin-only endpoints via the X-Admin-Key header. Empty = they stay closed
ALLOW_INSECURE_ADMIN=        # 1 = open admin endpoints without a key. LOCAL DEVELOPMENT ONLY
ALLOWED_COMPANIES=           # comma-separated company codes for users with no assignment (api_key mode); empty = any
TENANT_SCOPE=off             # off (default) = queries run unscoped; on = every query is filtered to one COMPANY_CODE / FISCAL_YEAR (several companies in one database)
USERS_FILE=                  # keys mode: where the users live (default data/users.json)
DEFAULT_COMPANY_CODE=          # company the web page and the acceptance runner ask about unless told otherwise (default 1)
DEFAULT_FISCAL_YEAR=          # default: the current calendar year
MONITOR_COMPANY_CODE=         # company the background alerts/health/briefing describe (default 1); only its users can read them
MONITOR_FISCAL_YEAR=          # default: the current calendar year
RBAC_STRICT=                  # 1 = a role restricted by branch but with no branch assigned sees no rows, for everyone
CORS_ORIGINS=*               # comma-separated origins, or * for development
RATE_LIMIT_CHAT=30           # requests per minute per client IP
RATE_LIMIT_LEARNING=60
LEARNING_API_KEY=
LEARNING_ADMIN_KEY=

# ── ERP write actions (create / update / approve) ────────────────────
ACTIONS_ENABLED=0            # 0 = off | pilot = only ACTIONS_PILOT_USERS | 1 = all admin/manager
ACTIONS_PILOT_USERS=         # comma-separated user ids (pilot mode)

# ── Behaviour ────────────────────────────────────────────────────────
SEMANTIC_FIRST=1             # reject a template whose meaning conflicts with the question
CONTEXT_ENFORCE=1
SCHEMA_TIERED=1
CLEANUP_INTERVAL_HOURS=6
DASHBOARD_MAX_CONCURRENT=5

# ── Storage ──────────────────────────────────────────────────────────
LEARNING_DB_PATH=            # SQLite file for sessions/actions/audit (default: data/learning.db)
LEARNING_FORCE_SQLITE=       # 1 = never try Oracle for learning data

# ── Oracle APEX integration ──────────────────────────────────────────
APEX_BASE_URL=
APEX_APP_ID=103

# ── Observability (optional) ─────────────────────────────────────────
OTEL_EXPORT_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=

ANSWER_MODE=comments          # comments (default): every data question is answered from the schema comments; templates: legacy ready-made SQL first
