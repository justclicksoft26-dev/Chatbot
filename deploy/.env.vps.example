# Copy to .env on the server and fill every line. This file is only a template: it holds no secrets.

# --- the public address (a domain pointing at the server, e.g. chat.example.com) ---
SITE_ADDRESS=chat.example.com

# --- Oracle (the server must be able to reach this host and port) ---
APP_PROFILE=justclick
DB_HOST=
DB_PORT=1521
DB_SID=
DB_USER=
DB_PASS=
DB_READ_USER=
DB_READ_PASS=

# --- which company / fiscal year the web page asks about (see: SELECT DISTINCT COMPANY_CODE, FISCAL_YEAR FROM MAIN_INV) ---
DEFAULT_COMPANY_CODE=1
DEFAULT_FISCAL_YEAR=2025

# --- the language model ---
LLM_PROVIDER=gemini
GEMINI_MODEL=gemini-3.8-flash
GEMINI_API_KEY=
GROQ_API_KEY=

# --- security: all required on a public server ---
API_KEY=                      # long random value; the page is opened once as https://<domain>/?key=<API_KEY>
ADMIN_API_KEY=                # a different long random value for the admin endpoints
AUTH_MODE=api_key
CORS_ORIGINS=https://chat.example.com
ACTIONS_ENABLED=0             # keep write actions off until sprint 5 has been accepted
ANSWER_MODE=comments
